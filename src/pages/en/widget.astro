---
import PageLayout from '../../layouts/PageLayout.astro';
import { SITE_URL } from '../../data/site-config';
import { route } from '../../i18n/routes';
import { breadcrumbSchema } from '../../lib/seo';
const lang = 'en';
const code = `<iframe src="${SITE_URL}/embed/finder/" title="Where is hot: holiday weather finder" width="100%" height="900" style="border:0;max-width:1100px" loading="lazy"></iframe>`;
---
<PageLayout title="Embed the holiday weather finder: where is hot by month" description="Travel blogs, schools and libraries can embed the where-is-hot finder, with highs, sea temperature and wet days for 62 places from NOAA data, in one iframe line. No cookie." lang={lang} noindex={true} jsonLd={[breadcrumbSchema([{ name: 'Home', path: route('home', lang) }, { name: 'Embed the finder', path: route('widget', lang) }])]} breadcrumbs={[{ label: 'Embed the finder' }]} showAuthor={false}>
  <header class="mb-6">
    <h1 class="font-serif text-3xl font-bold text-navy-900 md:text-4xl">Embed the holiday weather finder</h1>
    <p class="mt-3 text-lg text-navy-700">One line of code: pick a month and minimum temperatures, and the {62} places sort themselves.</p>
  </header>
  <div class="prose prose-slate max-w-none">
    <p>Terms: keep the credit line under the finder visible, including the NOAA acknowledgement, and do not alter the frame. The frame sets no cookie and sends us nothing about your readers. Questions: <a href={route('contact', lang)}>contact page</a>.</p>
    <h2>Where is hot finder</h2>
    <pre class="overflow-x-auto rounded-lg bg-navy-900 p-4 text-sm text-white"><code>{code}</code></pre>
  </div>
  <div class="mt-8 overflow-hidden rounded-xl border border-navy-200">
    <iframe src="/embed/finder/" title="Where is hot: holiday weather finder" width="100%" height="900" style="border:0" loading="lazy"></iframe>
  </div>
</PageLayout>
